# ========================================================
# PratibhaScan Web - Environment Configuration
# ========================================================

# General Application
VITE_APP_NAME="PratibhaScan Web"
VITE_APP_DESCRIPTION="Next-Gen Sports Talent Identification & Assessment Platform"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# Supabase Credentials (Get these from your Supabase Project Settings > API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Feature Flags
VITE_ENABLE_MOCK_DATA="true"
VITE_ENABLE_ANALYTICS="false"
VITE_DEFAULT_LANGUAGE="en"
